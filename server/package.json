{
  "name": "@vo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/dev.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "smoke": "tsx src/smoke/colyseus-compat.ts",
    "test:postgres": "tsx src/smoke/postgres.ts",
    "test": "tsx src/smoke/integration.ts && tsx src/smoke/validate.ts && tsx src/smoke/sessions.ts && tsx src/smoke/oauth.ts && tsx src/smoke/config.ts && tsx src/smoke/shutdown.ts && tsx src/smoke/restart.ts",
    "user": "tsx src/cli/user.ts"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.0",
    "@colyseus/ws-transport": "^0.16.5",
    "@vo/shared": "*",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "pg": "^8.13.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "@types/pg": "^8.11.10",
    "colyseus.js": "^0.16.22",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2"
  }
}
