# Copy to .env and fill in. Every value here has a working dev default except
# the OAuth credentials, so `npm run dev` runs with no .env at all.

# NODE_ENV is deliberately NOT set here. `npm run dev` sets it to development
# for you; anything other than exactly "development" (including unset) is
# treated as production, where dev sign-in is impossible and the guards below
# are enforced.
PORT=2567
LOG_LEVEL=info

# ---------------------------------------------------------------- auth
# Required outside development: at least 32 characters, and the server refuses
# to start without it. Generate one with:  openssl rand -base64 48
# (In development a built-in dev-only secret is used when this is unset.)
JWT_SECRET=
SESSION_TTL_SEC=604800
REALTIME_TTL_SEC=120

# --- Microsoft / Outlook (Entra ID) --------------------------------------
# Azure Portal -> Microsoft Entra ID -> App registrations -> New registration.
# Platform "Web", redirect URI must match MICROSOFT_CALLBACK_URL exactly.
# The secret comes from "Certificates & secrets" -> New client secret (copy the
# VALUE, not the Secret ID).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_CALLBACK_URL=http://localhost:5173/auth/microsoft/callback

# Your Entra directory (tenant) ID — this is the real access control, because
# Microsoft won't issue a token for anyone outside the tenant.
#   common        = any Microsoft account, personal included (TESTING ONLY)
#   organizations = any work/school account, any tenant
#   <tenant guid> = only your organisation      <- use this in production
# The server refuses to start in production while this is "common".
MICROSOFT_TENANT_ID=common

# --- GitHub -------------------------------------------------------------
# GitHub -> Settings -> Developer settings -> OAuth Apps -> New OAuth App.
# "Authorization callback URL" must match GITHUB_CALLBACK_URL exactly.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/auth/github/callback

# Configure either provider, or both. At least one is required in production.

# Optional extra restriction on top of the tenant check: only allow this email
# domain, e.g. acme.com. Applies to BOTH providers. Leave blank while testing.
# NOTE for GitHub: this checks the user's GitHub email, which is often a
# personal address — those people would be rejected. Prefer MICROSOFT_TENANT_ID
# as the real gate and leave this blank unless you need belt-and-braces.
ALLOWED_EMAIL_DOMAIN=

# Local-only shortcut that lets you sign in as an arbitrary name so you can open
# two tabs as two users without two real accounts. On by default in
# development; set false to turn it off there. It can never be on outside
# development, and the server REFUSES TO START if you set it to true there.
# DEV_AUTH=false

# ---------------------------------------------------------------- data
# Unset -> a local JSON file at .data/dev.json (zero setup).
# Set    -> PostgreSQL. docker-compose.yml provisions one for you.
# DATABASE_URL=postgres://vo:vo@localhost:5432/virtual_office

# ------------------------------------------------------------ NAT traversal
# Comma-separated. STUN alone is enough for most networks; add TURN when people
# behind symmetric NAT / strict corporate firewalls cannot connect. Adding TURN
# is env-only: no code change, no client rebuild.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
